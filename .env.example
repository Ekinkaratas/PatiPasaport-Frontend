# Bu dosyayı `.env` adıyla kopyalayıp değerleri doldurun. `.env` git'e ve
# Docker imajına girmez. Bu dosyaya gerçek şifre ya da gizli değer YAZMAYIN.
# Uygulama yedek değer kullanmaz: zorunlu bir değişken eksikse `npm run dev`,
# `npm run build`, `npm run e2e` ve `docker compose` açık bir hatayla durur.

# ---- Uygulama (geliştirme sunucusu ve build) ----

# Geliştirme sunucusunun (vite dev / preview) `/api` isteklerini aktaracağı gateway adresi.
# Sadece Vite proxy'si okur; tarayıcıya gömülmez. İstek bilgisayardaki Vite'tan
# çıktığı için telefondan erişimde de `localhost` kalabilir.
API_PROXY_TARGET=http://localhost:3000

# Tarayıcının API'ye istek atacağı taban yol. Production'da reverse proxy
# aynı origin altında `/api`'yi gateway'e aktarıyorsa değiştirmeye gerek yok.
#
# Telefondan / yerel ağdan erişim (`npm run dev:lan`, yani `vite --host`):
# bu değer GÖRELİ kalmalı (`/api`). `http://localhost:3000` gibi mutlak bir
# adres yazılırsa telefon kendi localhost'una gider ve istek bilgisayara hiç
# ulaşmaz. Telefon `http://<bilgisayarın-ip>:5173` adresini açar, `/api`
# isteklerini Vite proxy'si API_PROXY_TARGET'a aktarır. Ayrıntılar README'de.
VITE_API_BASE_URL=/api

# Sitede gösterilen iletişim adresi (alt bilgi, kayıt sayfası, KVKK metni).
# VITE_ önekli olduğu için tarayıcıya gömülür; gizli bir değer yazmayın.
VITE_CONTACT_EMAIL=iletisim@example.com

# Sitenin yayındaki adresi. Build sırasında sitemap.xml bu adresle üretilir.
SITE_URL=https://example.com

# Alt bilgideki GitHub bağlantıları (kaynak kod). İsteğe bağlı: boş bırakılan
# bağlantı gösterilmez. https:// ile başlamalı; tırnak işareti kullanmayın.
VITE_SOURCE_FRONTEND_URL=
VITE_SOURCE_BACKEND_URL=

# ---- Docker ile yayın (deploy/docker/docker-compose.yml) ----
# Komut proje kökünden: docker compose --env-file .env -f deploy/docker/docker-compose.yml up -d --build

# Gateway'in backend Docker ağındaki adresi (sonunda / olmadan).
API_UPSTREAM=http://gateway:3000

# Backend'in Docker ağı: `docker network ls` ile görülür (<backend-klasörü>_backend).
BACKEND_NETWORK=patipasaport_backend

# Web konteynerinin sunucuda dinleyeceği adres ve port. 127.0.0.1 yalnızca
# sunucunun içinden (TLS vekilinden) erişilebilir demektir.
WEB_BIND=127.0.0.1
WEB_PORT=8080

# ---- Duman testleri (`npm run e2e`) ----
# Sadece test hesaplarını yazın; gerçek hesap şifresi kullanmayın. Bu değerler
# yalnızca scripts/e2e.mjs tarafından okunur, uygulamaya gömülmez (VITE_ öneki yok).
E2E_BASE_URL=http://localhost:5173
E2E_OWNER_EMAIL=
E2E_OWNER_PASSWORD=
E2E_CLINIC_EMAIL=
E2E_CLINIC_PASSWORD=
